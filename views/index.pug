extends layout

block content 
  h1 Comments
  // add nav here
  h2 Here is what our customers have to say about Downtown Donuts:
  each val in comments
    h5
      span= val.title + ' - ' + val.rating + ' '
      if val.rating = 1
        span star
      else
        span stars
    p= val.comment
    p
      span= '- ' + val.name


  hr
  h2 Add a comment
  form(method='POST' action='/create')
    label(for='name') Name:
    input(type='text', name='name', id='name', required)
    label(for='title') Title:
    input(type='text', name='title', id='title', required)
    label(for='rating') Rating:
    input(type='number', min='0', max='5', name='rating' id='rating', required)
    input(type='textarea', rows='10', columns='250', name='comment', id='comment', val='Type comments here', required)
    button(type='submit') Post your comment
